rules_version = '2';

// ─────────────────────────────────────────────────────────────────
// BizStock — Firestore Security Rules (multi-tenant)
//
// HOW TO DEPLOY: Firebase Console → your project → Build → Firestore
// Database → Rules tab → paste this entire file → Publish.
// (Firestore rules always require a manual publish — this cannot be
// automated from code.)
//
// MULTI-TENANCY MODEL: every business's data lives in the SAME
// collections as every other business's — there's no per-tenant
// database or collection prefix. Isolation is enforced entirely by a
// `businessId` field on every document, checked against the CALLING
// USER's own businessId (read from their own /users/{uid} doc) on every
// single read and write. This is Firestore's documented multi-tenancy
// pattern: a rule that compares resource.data.businessId to a value
// derived from one get() on the caller's own doc is provably safe for
// Firestore to evaluate against LIST queries too, as long as the client
// query includes a matching `where("businessId", "==", ...)` clause —
// every lib/*.ts query in this app does exactly that.
//
// NEW BUSINESSES ARE NOT CREATED THROUGH THIS CLIENT PATH. Business
// signup is closed (see AUTHENTICATION.md) — new businesses are
// provisioned by scripts/create-business.mjs, which runs with the
// Firebase ADMIN SDK and therefore bypasses these rules entirely, same
// as every API route in app/api/*. The /business create rule below
// exists purely as a defensive fallback in case that path is ever
// exposed to the client directly — it is not the mechanism actually used
// today.
//
// Collections:
//   /business/{businessId}
//   /users/{uid}                        — businessId field
//   /products/{productId}               — businessId field
//   /stockMovements/{movementId}        — businessId field
//   /sales/{saleId}                     — businessId field
//   /purchases/{purchaseId}             — businessId field
//   /notifications/{uid}/items/{id}     — scoped by uid (1 uid = 1 business)
// ─────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getRole() {
      return isSignedIn() && userDoc().data.role != null ? userDoc().data.role : null;
    }

    function isActive() {
      return isSignedIn() && userDoc().data.active == true;
    }

    // The calling user's OWN businessId, read once from their own doc.
    // Every rule below compares against this — a user can never claim a
    // different businessId via request data, since this always re-reads
    // their real stored doc.
    function myBusinessId() {
      return userDoc().data.businessId;
    }

    function isOwner() {
      return isSignedIn() && isActive() && getRole() == "owner";
    }

    function isStaffOrOwner() {
      return isSignedIn() && isActive() && (getRole() == "owner" || getRole() == "staff");
    }

    // ---- /business/{businessId} --------------------------------------
    // Read: any active member (owner or staff) of THAT business.
    // Create: defensive fallback only — see note above. Self-claiming
    //         ownership only (ownerUid == caller); real provisioning
    //         happens server-side via the Admin SDK, which bypasses
    //         this rule entirely.
    // Update: owner of that specific business only (branding, name,
    //         default threshold — see Settings page).
    // Delete: nobody, from the client.

    match /business/{businessId} {
      allow read: if isStaffOrOwner() && businessId == myBusinessId();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isOwner() && businessId == myBusinessId();
      allow delete: if false;
    }

    // ---- /users/{uid} -------------------------------------------------
    // Read: a user can always read their own doc; an owner can read any
    //       user doc WITHIN THEIR OWN BUSINESS (Staff page list).
    // Create: defensive fallback only, same reasoning as /business above
    //         — owner accounts are actually created server-side by
    //         scripts/create-business.mjs (Admin SDK, bypasses rules).
    //         If this path were ever called from the client, it only
    //         allows creating your OWN doc, as role "owner", with a
    //         businessId pointing at a business you already own —
    //         this closes the exact hijack hole the earlier
    //         single-tenant version had (self-declaring "owner" of an
    //         arbitrary/existing businessId is impossible).
    //         Staff docs are always created server-side by
    //         /api/staff/create using the Admin SDK, with businessId
    //         taken from the calling owner's OWN doc — never from
    //         client input.
    // Update: owner only, and only within their own business (role
    //         changes, the active/deactivate toggle).
    // Delete: nobody, from the client — accounts are deactivated, not
    //         deleted, to preserve the audit trail on past sales.

    match /users/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        (isOwner() && resource.data.businessId == myBusinessId())
      );
      allow create: if isSignedIn()
                    && request.auth.uid == uid
                    && request.resource.data.role == "owner"
                    && request.resource.data.active == true
                    && get(/databases/$(database)/documents/business/$(request.resource.data.businessId)).data.ownerUid == request.auth.uid;
      allow update: if isOwner() && resource.data.businessId == myBusinessId();
      allow delete: if false;
    }

    // ---- /products/{productId} ----------------------------------------
    // Read: any active member of the SAME business.
    // Write (create/update/delete): owner of that business only. Stock
    //       quantity is also mutated by the server-side adjustStock()
    //       transaction via the Admin SDK, which bypasses these rules —
    //       the API routes independently re-verify businessId match
    //       before touching anything (see checkout/purchase routes).

    match /products/{productId} {
      allow read: if isStaffOrOwner() && resource.data.businessId == myBusinessId();
      allow create: if isOwner() && request.resource.data.businessId == myBusinessId();
      allow update: if isOwner()
                    && resource.data.businessId == myBusinessId()
                    && request.resource.data.businessId == myBusinessId();
      allow delete: if isOwner() && resource.data.businessId == myBusinessId();
    }

    // ---- /stockMovements/{movementId} ----------------------------------
    // Owner-only read, scoped to their own business. No client writes at
    // all: only the server (Admin SDK, via lib/stock.ts adjustStock())
    // ever writes movements.

    match /stockMovements/{movementId} {
      allow read: if isOwner() && resource.data.businessId == myBusinessId();
      allow write: if false;
    }

    // ---- /sales/{saleId} ------------------------------------------------
    // Read: both roles, scoped to their own business. No client writes:
    //       only POST /api/sales/checkout (Admin SDK) creates sale docs.

    match /sales/{saleId} {
      allow read: if isStaffOrOwner() && resource.data.businessId == myBusinessId();
      allow write: if false;
    }

    // ---- /purchases/{purchaseId} -----------------------------------------
    // Owner-only read, scoped to their own business. No client writes:
    // only POST /api/purchases/record (Admin SDK) creates these.

    match /purchases/{purchaseId} {
      allow read: if isOwner() && resource.data.businessId == myBusinessId();
      allow write: if false;
    }

    // ---- /notifications/{uid}/items/{notificationId} ---------------------
    // A user may only read/update their OWN notifications. This is
    // naturally tenant-isolated without needing a businessId check: each
    // uid belongs to exactly one business, so scoping by uid already
    // scopes by business. No client creates: only checkStockLevel() in
    // lib/stock.ts (Admin SDK) writes new notifications.

    match /notifications/{ownerUid}/items/{notificationId} {
      allow read: if isSignedIn() && request.auth.uid == ownerUid;
      allow update: if isSignedIn()
                    && request.auth.uid == ownerUid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);
      allow create, delete: if false;
    }

    // ---- /platformConfig/{doc} -------------------------------------------
    // Platform-wide settings editable from /admin (e.g. the WhatsApp
    // contact number) — read and written EXCLUSIVELY server-side via the
    // Admin SDK (lib/platform-config.ts), which bypasses these rules
    // entirely. No legitimate code path ever needs to reach this
    // collection through the client Firestore SDK, so it's deny-all here
    // — defense in depth, not the actual enforcement mechanism (that's
    // lib/admin-auth.ts's session check on every /api/admin/* route).

    match /platformConfig/{document} {
      allow read, write: if false;
    }
  }
}
