# ─────────────────────────────────────────────────────────────
# BizStock — environment variables
# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored by default (see .gitignore) — never commit it.
# ─────────────────────────────────────────────────────────────

# Firebase CLIENT config (safe to expose to the browser — these are
# public identifiers, not secrets). Firebase Console → Project settings →
# General → Your apps → SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Firebase ADMIN config — SERVER ONLY, never prefix with NEXT_PUBLIC_.
# Firebase Console → Project settings → Service accounts → Generate new
# private key. That downloads a JSON file — copy the three fields below
# from it. FIREBASE_ADMIN_PRIVATE_KEY must keep its "\n" sequences
# literal (as a single-line env var) — lib/firebase-admin.ts converts
# them back to real newlines at runtime.
# These same three values are also read by scripts/create-business.mjs
# (the CLI used to provision new client businesses — see ADMIN.md).
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Cloudinary — used for optional product photo uploads (lib/cloudinary.ts).
# Cloudinary Dashboard → Settings → Upload → Add upload preset →
# Signing Mode: UNSIGNED (required — the upload happens directly from the
# browser with no server-side signing step).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Platform admin panel (/admin) — SERVER ONLY, never prefix with
# NEXT_PUBLIC_. This is a single shared password for YOU, the platform
# operator — completely separate from Firebase Auth, see ADMIN.md and
# lib/admin-auth.ts. Use a long, random value for both — e.g. generate
# each with: openssl rand -hex 24
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

